# Copy to .env and fill in. Never commit .env.

# --- Vercel AI Gateway -------------------------------------------------------
# ONE credential powers both halves of the live experiment:
#   1. the Copilot CLI agent inside the sandbox (BYOK provider routing), and
#   2. the three evaluator models (Jev, Gemini 3.5 Flash Lite, GPT-5.4 nano).
# This project NEVER creates a Gateway key for you. Create it yourself in the
# Vercel dashboard (AI Gateway -> API keys) and paste it here.
AI_GATEWAY_API_KEY=

# Optional override. Verified default: https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# --- Vercel Sandbox ----------------------------------------------------------
# Needed only by `npm run trace:live`. Pick ONE of these:
#
#   A. OIDC (simplest on a laptop). Run `vercel link` then `vercel env pull`.
#      That writes VERCEL_OIDC_TOKEN into .env.local, which this project loads.
#      The token expires after about 12 hours: re-run `vercel env pull` when
#      `trace:live` fails with "Could not get credentials from OIDC context".
#
#   B. Access token (non-interactive; CI). Set all three together. Create the
#      token at https://vercel.com/account/tokens; find the IDs in the Vercel
#      dashboard under the team's and project's Settings > General.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
#
#   C. Nothing. In an interactive terminal the SDK opens a browser sign-in and
#      infers the team and project. Fine for a one-off, not for repeatability.

# Wall-clock cap per sandbox and per Copilot invocation, in milliseconds.
# SANDBOX_TIMEOUT_MS=600000
# COPILOT_TIMEOUT_MS=300000

# --- Agent under trace -------------------------------------------------------
# The model the Copilot CLI agent itself runs on, routed through the Gateway.
# Kept deliberately separate from the three evaluator models.
# AGENT_WIRE_MODEL=openai/gpt-4.1
# AGENT_MODEL_ID=gpt-4.1
# COPILOT_CLI_VERSION=1.0.86

# --- Live gating -------------------------------------------------------------
# Every live step fails closed unless this is exactly "yes".
LIVE_RUN_APPROVED=no

# NOTE: GitHub authentication is deliberately NOT used. Do not set GH_TOKEN,
# GITHUB_TOKEN or COPILOT_GITHUB_TOKEN; the agent runs in BYOK mode.
