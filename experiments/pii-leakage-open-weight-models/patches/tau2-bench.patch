diff --git a/src/tau2/user/scripted_user.py b/src/tau2/user/scripted_user.py
new file mode 100644
index 0000000..9edc1f8
--- /dev/null
+++ b/src/tau2/user/scripted_user.py
@@ -0,0 +1,116 @@
+"""Deterministic text-only customer dialogue for controlled adversarial tests."""
+
+from typing import Optional
+
+from tau2.data_model.message import Message, UserMessage
+from tau2.user.user_simulator_base import (
+    OUT_OF_SCOPE,
+    STOP,
+    TRANSFER,
+    HalfDuplexUser,
+    UserState,
+)
+
+
+class ScriptedUserState(UserState):
+    """Track progress in the fixed script independently of received content."""
+
+    next_message: int = 0
+
+
+class ScriptedUser(HalfDuplexUser[ScriptedUserState]):
+    """Emit only literal script entries, then stop; never call a language model.
+
+    This driver intentionally uses a fixed sequence rather than interpreting
+    agent replies. It cannot learn facts, paraphrase attacks, or invoke tools.
+    """
+
+    def __init__(
+        self,
+        messages: list[str],
+        instructions=None,
+        tools=None,
+        llm=None,
+        llm_args=None,
+        primary_message_index: Optional[int] = None,
+    ):
+        if not messages or any(
+            not isinstance(text, str) or not text.strip() for text in messages
+        ):
+            raise ValueError(
+                "scripted_user requires a nonempty list of nonempty messages"
+            )
+        if any(
+            marker in text
+            for text in messages
+            for marker in (STOP, TRANSFER, OUT_OF_SCOPE)
+        ):
+            raise ValueError(
+                "Stop markers are managed by scripted_user, not script entries"
+            )
+        super().__init__(instructions=instructions, tools=[])
+        self._script = tuple(messages)
+        if primary_message_index is not None and not 0 <= primary_message_index < len(
+            messages
+        ):
+            raise ValueError("Primary message index is outside the script")
+        self._primary_message_index = primary_message_index
+
+    def audit_trajectory(self, messages: list[Message]) -> dict:
+        """Report target delivery independently of the agent or safety judge."""
+        sent = [
+            message.content
+            for message in messages
+            if message.role == "user" and message.content != STOP
+        ]
+        matches = tuple(sent) == self._script[: len(sent)]
+        primary = self._primary_message_index
+        delivered = matches and primary is not None and len(sent) > primary
+        return {
+            "mode": "fixed_script",
+            "status": "invalid"
+            if not matches
+            else "valid"
+            if delivered
+            else "not_exercised",
+            "primary_message_index": primary,
+            "primary_delivered": delivered,
+            "script_prefix_matches": matches,
+            "script_complete": matches and len(sent) == len(self._script),
+            "sent_messages": len(sent),
+            "planned_messages": len(self._script),
+        }
+
+    def get_init_state(
+        self, message_history: Optional[list[Message]] = None
+    ) -> ScriptedUserState:
+        """Resume only when prior customer messages match the script exactly."""
+        history = list(message_history or [])
+        sent = [message.content for message in history if message.role == "user"]
+        if tuple(sent) != self._script[: len(sent)]:
+            raise ValueError("Customer history does not match the fixed script")
+        return ScriptedUserState(
+            system_messages=[], messages=history, next_message=len(sent)
+        )
+
+    def generate_next_message(self, message, state: ScriptedUserState):
+        """Ignore agent wording when choosing the next allowed customer message."""
+        if message is not None:
+            state.messages.append(message)
+        text = (
+            self._script[state.next_message]
+            if state.next_message < len(self._script)
+            else STOP
+        )
+        result = UserMessage(role="user", content=text)
+        state.next_message += 1
+        state.messages.append(result)
+        return result, state
+
+    def set_seed(self, seed: int):
+        """The script has no randomness."""
+
+    @classmethod
+    def is_stop(cls, message: UserMessage) -> bool:
+        """Stop only at the driver's exact terminal marker."""
+        return message.content == STOP
