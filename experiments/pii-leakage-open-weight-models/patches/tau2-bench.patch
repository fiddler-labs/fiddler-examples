+    """Fail explicitly when a selected suite is missing or invalid."""
+    splits = json.loads((directory / "split_tasks.json").read_text())
+    split = task_split_name or "base"
+    if split not in splits:
+        raise ValueError(f"Unknown banking leak task split: {split!r}")
+    directory = directory / "tasks"
+    tasks = []
+    for task_id in splits[split]:
+        task = Task.model_validate_json((directory / f"{task_id}.json").read_text())
+        if task.id != task_id:
+            raise ValueError(f"Task file ID does not match {task_id!r}")
+        tasks.append(task)
+    return tasks
